# Copie para .env.local e preencha

# Chave da API do Resend (https://resend.com/api-keys) - obrigatória
RESEND_API_KEY=

# Destinatário dos orçamentos recebidos pelo formulário (opcional)
CONTACT_TO_EMAIL=

# Remetente - use um domínio verificado no Resend em produção (opcional)
# Ex.: Alfa Esquadrias <contato@alfaesquadrias.com.br>
CONTACT_FROM_EMAIL=

# Higgsfield (npm run media) — formato KEY_ID:KEY_SECRET. Nunca versione.
HF_CREDENTIALS=
